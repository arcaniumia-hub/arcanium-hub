---
import Icon from './Icon.astro';
import type { Service } from '../data/en/services';
import { lowest, usd } from '../data/prices';

interface Props {
  services: Service[];
  exclude?: Service['id'];
}
const { services, exclude } = Astro.props;
const from: Record<Service['id'], string> = {
  'web-design': `Websites from ${usd(lowest.website)}`,
  'local-seo': `Plans from ${usd(lowest.seo)}/mo`,
  'social-media': `Plans from ${usd(lowest.social)}/mo`,
};
const list = services.filter((s) => s.id !== exclude);
---

<ul class:list={['grid gap-5', list.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
  {
    list.map((s) => (
      <li data-reveal>
        <a
          href={s.href}
          class="group card flex h-full flex-col p-7 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-(--shadow-lift)"
        >
          <span class="grid size-14 place-items-center rounded-2xl bg-pine text-honey transition-colors group-hover:bg-ember group-hover:text-white">
            <Icon name={s.icon} class="size-7" />
          </span>
          <h3 class="mt-6 text-2xl font-bold">{s.name}</h3>
          <p class="mt-1 font-semibold text-pine">{s.headline}</p>
          <p class="mt-3 text-ink-soft">{s.summary}</p>
          <ul class="mt-5 grid gap-2 text-[0.95rem]">
            {s.points.map((p) => (
              <li class="flex gap-2">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-ember" />
                {p}
              </li>
            ))}
          </ul>
          <span class="mt-auto flex items-center justify-between border-t border-line pt-5 font-semibold">
            <span class="text-sm text-ink-soft">{from[s.id]}</span>
            <span class="inline-flex items-center gap-1.5 text-pine">
              Learn more<span class="sr-only"> about {s.name}</span>
              <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
