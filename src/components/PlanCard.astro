---
/** Generic price card for website tiers, monthly plans and setup fees. */
import Icon from './Icon.astro';
import { usd } from '../data/prices';

interface Props {
  name: string;
  price: number;
  /** "from" (website tiers), "mo" (monthly), "once" (setup). */
  unit: 'from' | 'mo' | 'once';
  summary?: string;
  features: string[];
  meta?: { icon: 'clock' | 'browser' | 'calendar'; text: string }[];
  highlight?: boolean;
  badge?: string;
  note?: string;
  cta?: { label: string; href: string };
  headingLevel?: 'h2' | 'h3';
}
const { name, price, unit, summary, features, meta = [], highlight, badge, note, cta, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article
  class:list={['card relative flex h-full flex-col p-6 sm:p-7', highlight && 'ring-2 ring-pine']}
  data-reveal
>
  {
    badge && (
      <p class="absolute -top-3.5 left-6 rounded-full bg-pine px-3.5 py-1 text-xs font-extrabold tracking-wider text-cream uppercase">
        {badge}
      </p>
    )
  }
  <H class="text-xl font-bold sm:text-2xl">{name}</H>
  <p class="mt-4 flex items-baseline gap-1.5">
    {unit === 'from' && <span class="text-sm font-semibold text-ink-soft">from</span>}
    <span class="font-display text-4xl font-extrabold tracking-tight">{usd(price)}</span>
    {unit === 'mo' && <span class="font-semibold text-ink-soft">/mo</span>}
    {unit === 'once' && <span class="font-semibold text-ink-soft">one-time</span>}
  </p>
  {
    meta.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {meta.map((m) => (
          <li class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1 text-sm font-semibold text-ink">
            <Icon name={m.icon} class="size-4 text-pine" />
            {m.text}
          </li>
        ))}
      </ul>
    )
  }
  {summary && <p class="mt-4 text-[0.97rem] text-ink-soft">{summary}</p>}
  <ul class="mt-5 grid gap-2.5 border-t border-line pt-5 text-[0.97rem]">
    {
      features.map((f) => (
        <li class="flex gap-2.5">
          <Icon name="check" class="mt-1 size-[1.1rem] shrink-0 text-ember" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  {note && <p class="mt-4 text-sm text-ink-soft">{note}</p>}
  {
    cta && (
      <div class="mt-auto pt-6">
        <a href={cta.href} class:list={['btn w-full', highlight ? 'btn-primary' : 'btn-secondary']}>
          {cta.label}
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    )
  }
</article>
