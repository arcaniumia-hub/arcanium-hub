---
import Icon from './Icon.astro';
import type { Testimonial } from '../data/en/testimonials';
interface Props {
  items: Testimonial[];
}
const { items } = Astro.props;
---

<ul class="grid gap-5 md:grid-cols-3">
  {
    items.map((t) => (
      <li data-reveal>
        <figure class="card flex h-full flex-col p-7">
          <Icon name="quote" class="size-8 text-ember" />
          {t.placeholder && <span class="placeholder-tag mt-4 w-fit">Placeholder</span>}
          <blockquote class="mt-4 flex-1 text-lg leading-relaxed">
            <p>{t.quote}</p>
          </blockquote>
          <figcaption class="mt-6 border-t border-line pt-5">
            <span class="block font-bold">{t.name}</span>
            <span class="block text-sm text-ink-soft">{t.role}</span>
            <span class="mt-2 inline-block rounded-full bg-sand px-2.5 py-0.5 text-xs font-bold text-pine">{t.service}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
