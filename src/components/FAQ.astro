---
/** Accessible FAQ accordion (native <details>, no JS). Pair with faqSchema() on the page. */
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import type { FAQ } from '../data/en/faqs';

interface Props {
  items: FAQ[];
  title?: string;
  eyebrow?: string;
  more?: { href: string; label: string };
}
const { items, title = 'Frequently asked questions', eyebrow = 'FAQ', more } = Astro.props;
---

<section class="section" aria-labelledby="faq-title">
  <div class="container-x grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHeader eyebrow={eyebrow} title={title} id="faq-title">
        <p class="mt-4 text-ink-soft">
          Still have a question? <a href="/contact/" class="link">Ask us directly</a> — you will get a real answer from a real person.
        </p>
      </SectionHeader>
    </div>
    <div class="lg:col-span-8">
      <div class="divide-y divide-line rounded-(--radius-card) border border-line bg-white">
        {
          items.map((f) => (
            <details class="group px-5 sm:px-7">
              <summary class="flex cursor-pointer items-start justify-between gap-6 py-5 text-lg font-semibold">
                <h3 class="font-sans text-[1.075rem] leading-snug font-semibold tracking-normal">{f.q}</h3>
                <span class="faq-icon mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-sand text-pine transition-transform">
                  <Icon name="plus" class="size-4" />
                </span>
              </summary>
              <div class="-mt-1 pb-6 text-ink-soft [&_a]:font-semibold [&_a]:text-pine [&_a]:underline [&_a]:decoration-ember/60 [&_a]:underline-offset-4" set:html={f.a} />
            </details>
          ))
        }
      </div>
      {more && <p class="mt-6"><a href={more.href} class="link">{more.label} →</a></p>}
    </div>
  </div>
</section>
