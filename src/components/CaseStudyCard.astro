---
import { Picture } from 'astro:assets';
import type { CaseStudy } from '../data/en/portfolio';

interface Props {
  study: CaseStudy;
  headingLevel?: 'h2' | 'h3';
}
const { study, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="group card flex h-full flex-col overflow-hidden" data-reveal>
  <a href={`/work/${study.slug}/`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <Picture
      src={study.image}
      alt=""
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 100vw"
      formats={['avif', 'webp']}
      class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      {study.placeholder && <span class="placeholder-tag">Placeholder</span>}
      {study.services.map((s) => <span class="rounded-full bg-pine-100 px-2.5 py-0.5 text-xs font-bold text-pine">{s}</span>)}
    </div>
    <H class="mt-3 text-xl font-bold">
      <a href={`/work/${study.slug}/`} class="hover:text-pine">{study.title}</a>
    </H>
    <dl class="mt-4 grid gap-3 text-[0.95rem]">
      <div>
        <dt class="text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">Challenge</dt>
        <dd class="mt-0.5 line-clamp-3">{study.challenge}</dd>
      </div>
      <div>
        <dt class="text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">Results</dt>
        <dd class="mt-0.5">{study.results[0]}</dd>
      </div>
    </dl>
    <a href={`/work/${study.slug}/`} class="link mt-auto pt-5 text-[0.95rem]">
      Read the case study<span class="sr-only">: {study.title}</span> →
    </a>
  </div>
</article>
