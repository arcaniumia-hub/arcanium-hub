---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
}
const { eyebrow, title, lead, align = 'left', id } = Astro.props;
---

<div class:list={['mb-10 max-w-2xl sm:mb-14', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="h-section" set:html={title} />
  {lead && <p class="lead mt-4">{lead}</p>}
  <slot />
</div>
