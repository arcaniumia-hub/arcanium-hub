---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { getContent } from '../../data';
import type { CaseStudy } from '../../data/en/portfolio';

export function getStaticPaths() {
  const studies = getContent('en').caseStudies;
  return studies.map((study) => ({ params: { slug: study.slug }, props: { study, others: studies.filter((s) => s.slug !== study.slug) } }));
}

interface Props {
  study: CaseStudy;
  others: CaseStudy[];
}
const { study, others } = Astro.props;
const serviceLinks: Record<string, string> = {
  'Website Design': '/web-design/',
  'Local SEO': '/local-seo/',
  'Social Media': '/social-media/',
};
---

<BaseLayout
  title={`${study.title} — Case Study`}
  description={`How Braven Digital helped a ${study.clientType.toLowerCase()} with ${study.services.join(' and ').toLowerCase()}: the challenge, what we did and the results.`}
  breadcrumbs={[
    { name: 'Work', href: '/work/' },
    { name: study.title, href: `/work/${study.slug}/` },
  ]}
  noindex={study.placeholder}
>
  <article>
    <header class="container-x pt-10 pb-10 sm:pt-14">
      <div class="flex flex-wrap items-center gap-2">
        {study.placeholder && <span class="placeholder-tag">Placeholder</span>}
        {
          study.services.map((s) => (
            <a href={serviceLinks[s]} class="rounded-full bg-pine-100 px-3 py-1 text-sm font-bold text-pine hover:bg-pine hover:text-cream">{s}</a>
          ))
        }
      </div>
      <h1 class="mt-4 max-w-4xl text-4xl font-extrabold sm:text-5xl">{study.title}</h1>
      <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3 text-[0.97rem]">
        <div><dt class="text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">Client</dt><dd class="font-semibold">{study.clientType}</dd></div>
        <div><dt class="text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">Location</dt><dd class="font-semibold">{study.location}</dd></div>
        {study.url && <div><dt class="text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">Website</dt><dd><a href={study.url} class="link" rel="noopener" target="_blank">Visit site</a></dd></div>}
      </dl>
    </header>

    <div class="container-x">
      <Picture
        src={study.image}
        alt={study.imageAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1152px) 1088px, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full rounded-[1.5rem] object-cover"
      />
    </div>

    <div class="container-x grid gap-10 py-16 lg:grid-cols-3">
      <section aria-labelledby="challenge">
        <h2 id="challenge" class="text-2xl font-bold">The challenge</h2>
        <p class="mt-3 text-ink-soft">{study.challenge}</p>
      </section>
      <section aria-labelledby="did">
        <h2 id="did" class="text-2xl font-bold">What we did</h2>
        <ul class="mt-3 grid gap-2.5">
          {study.whatWeDid.map((w) => <li class="flex gap-2.5"><Icon name="check" class="mt-1 size-4 shrink-0 text-ember" />{w}</li>)}
        </ul>
      </section>
      <section aria-labelledby="results" class="rounded-(--radius-card) bg-pine p-6 text-pine-100">
        <h2 id="results" class="text-2xl font-bold text-cream">Results</h2>
        <ul class="mt-3 grid gap-2.5">
          {study.results.map((r) => <li class="flex gap-2.5"><Icon name="chart" class="mt-1 size-4 shrink-0 text-honey" />{r}</li>)}
        </ul>
      </section>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section bg-sand/60 pt-16" aria-labelledby="more-title">
        <div class="container-x">
          <h2 id="more-title" class="h-section mb-10">More projects</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {others.slice(0, 2).map((s) => <CaseStudyCard study={s} />)}
          </div>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
