---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { bookingHref, isPlaceholder, site } from '../../config/site';
import { categories } from '../../data/blog-categories';
import { blogPostingSchema } from '../../lib/schema';
import { formatDate, getPosts, postSlug, postUrl, readingTime, wordCount, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

interface Props {
  post: Post;
  related: Post[];
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const cat = categories[post.data.category];
const path = postUrl(post);
const og = await getImage({ src: post.data.cover, width: 1200, height: 675, format: 'jpg', fit: 'cover' });
const toc = headings.filter((h) => h.depth === 2);
const author = isPlaceholder(site.founder) ? `The ${site.name} team` : site.founder;
const ext = bookingHref.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={og.src}
  imageAlt={post.data.coverAlt}
  article={{ published: post.data.pubDate, modified: post.data.updatedDate, section: cat.name }}
  breadcrumbs={[
    { name: 'Blog', href: '/blog/' },
    { name: cat.name, href: `/blog/category/${post.data.category}/` },
    { name: post.data.title, href: path },
  ]}
  schema={[
    blogPostingSchema({
      title: post.data.title,
      description: post.data.description,
      path,
      image: new URL(og.src, Astro.site).href,
      datePublished: post.data.pubDate,
      dateModified: post.data.updatedDate,
      category: cat.name,
      wordCount: wordCount(post.body),
    }),
  ]}
>
  <article>
    <header class="container-x max-w-4xl pt-10 sm:pt-14">
      <p class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
        <a href={`/blog/category/${post.data.category}/`} class="rounded-full bg-pine-100 px-3 py-1 text-xs font-bold text-pine hover:bg-pine hover:text-cream">{cat.name}</a>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>· Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>}
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1 class="mt-5 text-4xl font-extrabold sm:text-5xl lg:text-[3.4rem]">{post.data.title}</h1>
      <p class="lead mt-5">{post.data.description}</p>
      <p class="mt-6 flex items-center gap-3 text-[0.95rem]">
        <span class="grid size-10 place-items-center rounded-full bg-pine font-display font-bold text-honey" aria-hidden="true">B</span>
        <span>By <a href="/about/" class="font-semibold hover:underline">{author}</a>{!isPlaceholder(site.founder) && `, ${site.name}`}</span>
      </p>
    </header>

    <div class="container-x mt-10 max-w-5xl">
      <Picture
        src={post.data.cover}
        alt={post.data.coverAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 960px, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full rounded-[1.5rem] object-cover"
      />
    </div>

    <div class="container-x mt-12 grid max-w-5xl gap-10 lg:grid-cols-[1fr_15rem]">
      <div
        class="prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-3xl prose-a:font-semibold prose-a:text-pine prose-a:decoration-ember/60 prose-a:decoration-2 prose-a:underline-offset-4 hover:prose-a:decoration-ember prose-strong:text-ink prose-li:marker:text-ember prose-table:text-base prose-th:bg-sand prose-th:p-3 prose-td:p-3 prose-p:text-ink/90 prose-li:text-ink/90"
      >
        <Content />
      </div>

      <aside class="order-first lg:order-none">
        <div class="grid gap-5 lg:sticky lg:top-28">
          {
            toc.length > 0 && (
              <nav aria-labelledby="toc-title" class="rounded-2xl border border-line bg-white p-5">
                <h2 id="toc-title" class="font-sans text-xs font-bold tracking-[0.14em] text-ink-soft uppercase">In this article</h2>
                <ol class="mt-3 grid gap-2 text-[0.93rem]">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="text-ink hover:text-pine hover:underline">{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="hidden rounded-2xl bg-pine p-5 text-pine-100 lg:block">
            <p class="font-display text-lg font-bold text-cream">Want help with this?</p>
            <p class="mt-2 text-sm">Book a free 20-minute call. Honest advice, no pressure.</p>
            <a href={bookingHref} class="btn btn-primary mt-4 w-full min-h-11 py-2 text-sm" {...ext}><Icon name="calendar" class="size-4" />Book a Free Call</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="container-x">
          <h2 id="related-title" class="h-section mb-10">Keep reading</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {related.map((p) => <PostCard post={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
